-- Provincia
INSERT INTO Provincia (cod_prov, nombre_prov)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Sucursal_Provincia), -- Asignar cod_prov
    Sucursal_Provincia
FROM TablaMaestra;

-- Localidad
INSERT INTO Localidad (cod_localidad, nombre_localidad, provincia)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Sucursal_Localidad), -- cod_localidad
    Sucursal_Localidad,
    (SELECT cod_prov FROM Provincia WHERE nombre_prov = Sucursal_Provincia)
FROM TablaMaestra;

-- Cliente
INSERT INTO Cliente (nro_cliente, dni, localidad, nombre, apellido, fecha_nacimiento, mail, direccion, telefono)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Cliente_Dni),
    Cliente_Dni,
    (SELECT cod_localidad FROM Localidad WHERE nombre_localidad = Cliente_Localidad),
    Cliente_Nombre,
    Cliente_Apellido,
    Cliente_FechaNacimiento,
    Cliente_Mail,
    Cliente_Direccion,
    Cliente_Telefono
FROM TablaMaestra;

-- Sucursal
INSERT INTO Sucursal (id_sucursal, localidad, nro_sucursal, direccion, telefono, mail)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Sucursal_NroSucursal),
    (SELECT cod_localidad FROM Localidad WHERE nombre_localidad = Sucursal_Localidad),
    Sucursal_NroSucursal,
    Sucursal_Direccion,
    Sucursal_Telefono,
    Sucursal_Mail
FROM TablaMaestra;

-- Sillon_Modelo
INSERT INTO Sillon_Modelo (codigo_modelo, nombre, descripcion, precio_base)
SELECT DISTINCT
    Sillon_Modelo_Codigo,
    Sillon_Modelo,
    Sillon_Modelo_Descripcion,
    Sillon_Modelo_Precio
FROM TablaMaestra;

-- Sillon_Medida
INSERT INTO Sillon_Medida (id_medida, alto, ancho, profundidad, precio_medida)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Sillon_Medida_Alto),
    Sillon_Medida_Alto,
    Sillon_Medida_Ancho,
    Sillon_Medida_Profundidad,
    Sillon_Medida_Precio
FROM TablaMaestra;

-- Material
INSERT INTO Material (id_material, nombre, precio)
SELECT DISTINCT
    ROW_NUMBER() OVER (ORDER BY Material_Nombre),
    Material_Nombre,
    Material_Precio
FROM TablaMaestra;

-- Tela
INSERT INTO Tela (id_tela, id_material, color, textura)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Tela_Color),
    (SELECT id_material FROM Material WHERE nombre = Material_Nombre),
    Tela_Color,
    Tela_Textura
FROM TablaMaestra;

-- Madera
INSERT INTO Madera (id_madera, id_material, nombre, descripcion, color, dureza)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Madera_Color),
    (SELECT id_material FROM Material WHERE nombre = Material_Nombre),
    Material_Nombre,
    Material_Descripcion,
    Madera_Color,
    Madera_Dureza
FROM TablaMaestra;

-- Relleno
INSERT INTO Relleno (id_relleno, id_material, nombre, descripcion, densidad)
SELECT DISTINCT 
    ROW_NUMBER() OVER (ORDER BY Material_Nombre),
    (SELECT id_material FROM Material WHERE nombre = Material_Nombre),
    Material_Nombre,
    Material_Descripcion,
    Relleno_Densidad
FROM TablaMaestra;

-- Sillon
INSERT INTO Sillon (id_sillon, codigo_modelo, id_medida, id_material)
SELECT DISTINCT 
    Sillon_Codigo,
    Sillon_Modelo_Codigo,
    (SELECT id_medida FROM Sillon_Medida 
     WHERE alto = Sillon_Medida_Alto AND ancho = Sillon_Medida_Ancho AND profundidad = Sillon_Medida_Profundidad),
    (SELECT id_material FROM Material WHERE nombre = Material_Nombre)
FROM TablaMaestra;

-- Pedido
INSERT INTO Pedido (nro_pedido, fecha, estado, total, nro_cliente, id_sucursal)
SELECT DISTINCT 
    Pedido_Numero,
    Pedido_Fecha,
    Pedido_Estado,
    Pedido_Total,
    (SELECT nro_cliente FROM Cliente WHERE dni = Cliente_Dni),
    (SELECT id_sucursal FROM Sucursal WHERE nro_sucursal = Sucursal_NroSucursal)
FROM TablaMaestra;

-- Cancelación de Pedido
INSERT INTO CancelacionPedido (nro_pedido, fecha_cancelacion, motivo_cancelacion)
SELECT DISTINCT 
    Pedido_Numero,
    Pedido_Cancelacion_Fecha,
    Pedido_Cancelacion_Motivo
FROM TablaMaestra
WHERE Pedido_Cancelacion_Fecha IS NOT NULL;

-- Detalle_Pedido
INSERT INTO Detalle_Pedido (nro_pedido, id_sillon, cantidad, precio, subtotal)
SELECT 
    Pedido_Numero,
    Sillon_Codigo,
    Detalle_Pedido_Cantidad,
    Detalle_Pedido_Precio,
    Detalle_Pedido_SubTotal
FROM TablaMaestra;

-- Factura
INSERT INTO Factura (nro_factura, id_sucursal, nro_cliente, fecha, total)
SELECT DISTINCT 
    Factura_Numero,
    (SELECT id_sucursal FROM Sucursal WHERE nro_sucursal = Sucursal_NroSucursal),
    (SELECT nro_cliente FROM Cliente WHERE dni = Cliente_Dni),
    Factura_Fecha,
    Factura_Total
FROM TablaMaestra;

-- Detalle_Factura
INSERT INTO Detalle_Factura (nro_factura, nro_pedido, cantidad, precio, subtotal)
SELECT 
    Factura_Numero,
    Pedido_Numero,
    Detalle_Pedido_Cantidad,
    Detalle_Factura_Precio,
    Detalle_Pedido_SubTotal
FROM TablaMaestra;

-- Compra
INSERT INTO Compra (nro_compra, suc_compra, fecha, total, cuit_proveedor)
SELECT DISTINCT
    Compra_Numero,
    (SELECT id_sucursal FROM Sucursal WHERE nro_sucursal = Sucursal_NroSucursal),
    Compra_Fecha,
    Compra_Total,
    Proveedor_CUIT
FROM TablaMaestra;

-- Detalle_Compra
INSERT INTO Detalle_Compra (nro_compra, material_comprado, cantidad, precio, subtotal)
SELECT 
    Compra_Numero,
    (SELECT id_material FROM Material WHERE nombre = Material_Nombre),
    Compra_Cantidad,
    Compra_Precio,
    Compra_Subtotal
FROM TablaMaestra;
